# Votepit — SMTP test configuration (template)
# --------------------------------------------------------------------------
# Copy:   cp config/smtp-test.env.example config/smtp-test.env
# Run:    set -a; source config/smtp-test.env; set +a
#         php bin/send-test-mail.php your@address.com
#
# config/smtp-test.env is gitignored — never commit secrets.
# This uses EXACTLY the same mailer as magic-link sending → success here
# proves the production path.
# ==========================================================================

# ── Option A: local proof without a real provider (Mailpit catcher) ────────
# docker run -d --name votepit-mailpit -p 1025:1025 -p 8025:8025 \
#   public.ecr.aws/supabase/mailpit
# Web UI for caught mails: http://localhost:8025
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=          # empty = no encryption (local only!)
SMTP_FROM_EMAIL=noreply@votepit.test
SMTP_FROM_NAME=Votepit

# ── Option B: Microsoft Outlook (personal outlook.com account) ─────────────
# Prerequisite: 2FA ON for the Microsoft account + an app password created
# under account.microsoft.com → Security → Advanced security options →
# App passwords. Use the app password (NOT the regular password) as SMTP_PASS.
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587
# SMTP_USER=your@outlook.com
# SMTP_PASS=<app-password>
# SMTP_ENCRYPTION=tls        # STARTTLS on 587
# SMTP_FROM_EMAIL=your@outlook.com   # must equal SMTP_USER (Outlook enforces this)
# SMTP_FROM_NAME=Votepit

# ── Option C: Microsoft 365 (business / own domain) ─────────────────────────
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=you@yourcompany.com
# SMTP_PASS=<app-password while basic auth is still active>
# SMTP_ENCRYPTION=tls
# SMTP_FROM_EMAIL=you@yourcompany.com
# SMTP_FROM_NAME=Votepit
#
# ⚠ IMPORTANT (research as of 06/2026): Microsoft is phasing out basic auth
# for SMTP AUTH (app passwords) — starting 2026-04-30, complete by end of
# 2026. After that, smtp.office365.com requires OAuth2 (XOAUTH2, Azure app
# registration). For production, the long-term option is therefore either
# OAuth2 or a transactional mail provider (Brevo/Mailgun/Postmark/SMTP2GO)
# or your own host's SMTP. That's exactly why this SMTP config is
# provider-neutral.

# ── Option D: SMTPS (port 465, implicit TLS) ────────────────────────────────
# SMTP_PORT=465
# SMTP_ENCRYPTION=ssl
