# Votepit — Apache configuration for the webroot (public/).

# Under CGI/FastCGI SAPIs (the common case on shared hosting), Apache does
# NOT forward the Authorization header to PHP by default (mod_php is the one
# exception) — getallheaders()/apache_request_headers() simply never see it,
# so ApiTokenAuthenticator::resolve() (core/src/Security/ApiTokenAuthenticator.php)
# reads an empty header and treats every Bearer-token request as
# unauthenticated, no matter how correct the token is. Confirmed live against
# a CGI/FastCGI production install: a verified-valid token on GET
# /api/v1/board came back 401, and the same token on POST /api/v1/mcp and
# POST /api/v1/ideas came back 403 "CSRF token invalid." — CsrfMiddleware's
# own bearer exemption
# (str_starts_with($request->getHeaderLine('Authorization'), 'Bearer ')) only
# ever sees the header on GET (irrelevant there — CSRF already bypasses safe
# verbs), never on POST, because it never arrives at all. CGIPassAuth
# (Apache 2.4.13+) would be the more direct fix, but risks a hard 500 on any
# older httpd that rejects the unknown directive in .htaccess — mirroring
# the header into an env var via mod_rewrite below achieves the same result
# with a module this file already requires. Without this, the entire Agent
# API (Bearer-token REST + MCP) is unusable for every mutating request, and
# reads only work by accident (GET's CSRF safe-verb bypass hides the missing
# header, doesn't restore it).
<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{HTTP:Authorization} ^(.+)
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]

    # Route every non-existent path to the front controller.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

# Web app manifest (PWA install metadata): serve with its registered MIME type.
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>

# Never serve hidden files (e.g. .htaccess itself).
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Webserver hardening (OWASP/BSI audit remediation issue 07): no directory
# listing, no server-generated-document footer leaking the Apache/PHP
# version. Both directives are valid in .htaccess (Override: All/Indexes) —
# unlike TraceEnable/ServerTokens below, which Apache only accepts in
# server-config/virtual-host context and therefore CANNOT live here (Apache
# rejects an .htaccess containing them outright, which would 500 every
# request on affected hosts) — those two are set in core/docker/apache-
# vhost.conf for the Docker image, and documented as a manual per-host check
# for shared hosting (see documentation/operations.md).
Options -Indexes
ServerSignature Off

# Security headers for the static SPA assets (index.html, JS/CSS bundles).
# These files NEVER pass through index.php/Slim — SecurityHeaderMiddleware
# only applies to API JSON responses (see its class doc). Without this
# block the page actually rendered by the browser (where XSS/clickjacking
# matter in the first place) would have none of these protections — the
# focus so far was exclusively on the API side.
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
    # script-src/style-src: no inline scripts anywhere in the built SPA (both
    # tags in index.html are external file src); the former noscript-fallback
    # inline <style> block was moved into the built CSS bundle (index.css,
    # class .vp-noscript-fallback) so no inline <style> element exists
    # anywhere either — script-src/style-src-elem both stay 'self' only, no
    # exception needed. A self-hosted installation talks to no third-party
    # origin at all — every source list is 'self'. An operator who plugs in
    # an extension that needs an external origin (e.g. a payment provider's
    # checkout script) widens the policy in their own deployment (a later
    # `Header always set Content-Security-Policy` in this file replaces this
    # one), never here.
    # No 'unsafe-inline' anywhere in style-src*: React's style={{}} prop
    # applies each declaration via direct CSSStyleDeclaration property
    # assignment, a sink neither style-src-attr nor style-src-elem governs
    # (only markup/setAttribute('style', …)/style.cssText are) — see
    # SecurityHeaderMiddleware.php's matching comment for the full rationale
    # (issue 06 of the OWASP/BSI audit remediation), kept in lockstep here.
    # No third-party origin is allowed here by default. If you configure a
    # Matomo tracker (matomo_url, or telemetry_matomo_url), add its origin
    # (https://host) to script-src AND connect-src below, so the static
    # Apache policy matches what PHP allows (Config::trackerOrigins()).
    # See documentation/installation.md.
    # img-src https:: a board's logo_url may be any externally-hosted https
    # image (BrandingValidator::logoUrl() already rejects javascript:/data:/
    # relative-without-leading-slash schemes there); passive image content,
    # never script execution.
    # img-src blob:: the local preview of an image picked for upload
    # (URL.createObjectURL); only this origin can create such a URL.
    # base-uri 'none': nothing in this SPA renders a relative <base> tag.
    # (The CSP line itself sits in the framing block below.)

    # ── Framing (embeddable widget, ADR 0005) ────────────────────────────
    # X-Frame-Options, CORP and the CSP (which carries frame-ancestors) are
    # set for every response EXCEPT a successful iframe page of the widget,
    # GET /{account}/{board}/widget (self-host: /{board}/widget). That one
    # page is rendered by PHP (public/index.php hands it to Slim, never to
    # the static SPA shell) and SecurityHeaderMiddleware relaxes its
    # frame-ancestors to the board's validated origin list and omits
    # X-Frame-Options. Apache must stay out of it entirely: depending on the
    # PHP handler a static `Header always set` either REPLACES PHP's value
    # (verified with mod_cgi + php-cgi: the static 'none'/DENY wins) or is
    # sent IN ADDITION (two CSPs are enforced as an intersection, so 'none'
    # wins again; a second XFO DENY blocks the frame). Either way a static
    # value would break the embed, so for that one response it is not set.
    #
    # Matched on THE_REQUEST (the raw request line), not REQUEST_URI: after
    # the front-controller rewrite above REQUEST_URI is /index.php. The
    # pattern stays in lockstep with $isWidgetPageRoute in index.php and the
    # route `{board}/widget` (WidgetRoutes); a query string is tolerated.
    # Any non-200 status on that path (Slim error page, unknown account,
    # 404 because the widget is off, 405 on HEAD) gets the strict headers
    # again — fail-secure; PHP's own strict values on a 404 are identical,
    # so the duplicate there is harmless. Pinned by HtaccessFramingTest.
    # Header-level `expr=` (evaluated when the response goes out, so the
    # final status is known) — NOT an <If> section, which Apache evaluates
    # while mapping the request, before the status exists.
    Header always set X-Frame-Options "DENY" "expr=%{THE_REQUEST} !~ m#^GET /(?:[a-z0-9-]+/)?[a-z0-9-]+/widget(?:\?\S*)? HTTP/# || %{REQUEST_STATUS} != 200"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'none'; style-src-elem 'self'; img-src 'self' data: blob: https:; connect-src 'self'; frame-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'" "expr=%{THE_REQUEST} !~ m#^GET /(?:[a-z0-9-]+/)?[a-z0-9-]+/widget(?:\?\S*)? HTTP/# || %{REQUEST_STATUS} != 200"
    Header always set Cross-Origin-Resource-Policy "same-origin" "expr=(%{THE_REQUEST} !~ m#^GET /(?:[a-z0-9-]+/)?[a-z0-9-]+/widget(?:\?\S*)? HTTP/# || %{REQUEST_STATUS} != 200) && %{REQUEST_URI} != '/widget.js'"

    # The widget loader script is embedded cross-origin on customer sites
    # (`<script src="https://app…/widget.js">`): CORP same-origin would make
    # the browser refuse it, and the CORS header allows an SRI/crossorigin
    # load. Static, contains no data.
    Header always set Cross-Origin-Resource-Policy "cross-origin" "expr=%{REQUEST_URI} == '/widget.js'"
    Header always set Access-Control-Allow-Origin "*" "expr=%{REQUEST_URI} == '/widget.js'"
    Header always set Cache-Control "public, max-age=300" "expr=%{REQUEST_URI} == '/widget.js'"
</IfModule>

# Caching: index.html references Vite's content-hashed chunk filenames
# (assets/Foo-<hash>.js) — after a deploy, the old hashed files are gone.
# Without an explicit Cache-Control, browsers may keep serving a stale
# index.html that points at now-deleted chunks, so a lazy route (e.g.
# /profile) silently fails to load (dynamic import() 404s, no visible
# error). index.html/root: always revalidate. Hashed assets: filename
# changes on every build, so they're safe to cache forever.
<IfModule mod_headers.c>
    <FilesMatch "^index\.html$">
        Header always set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>
<IfModule mod_headers.c>
    <If "%{REQUEST_URI} =~ m#^/assets/#">
        Header always set Cache-Control "public, max-age=31536000, immutable"
    </If>
</IfModule>
