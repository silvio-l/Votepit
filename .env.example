# Votepit — Docker self-host environment (docker-compose.yml).
#
# Copy to `.env` next to docker-compose.yml and fill in. This is the
# Docker-only equivalent of config/config.example.php (see there for what
# each value means) — docker/generate-config.php turns these into
# config/config.php inside the container on first start.
#
# `.env` is gitignored — never commit it, it holds live secrets.

# Public base URL of the installation (no trailing slash).
VOTEPIT_APP_URL=http://localhost:8080

# Two independent secrets — generate each separately:
#   php -r "echo bin2hex(random_bytes(32));"
VOTEPIT_APP_KEY=
VOTEPIT_IDENTITY_SERVER_KEY=

# Comma-separated list of admin email addresses (become admin on first
# magic-link login).
VOTEPIT_ADMIN_EMAILS=you@example.com

# Database — the `db` service in docker-compose.yml uses the same values.
VOTEPIT_DB_NAME=votepit
VOTEPIT_DB_USER=votepit
VOTEPIT_DB_PASS=

# SMTP for magic-link delivery — required, magic-link sign-in has no
# password fallback.
VOTEPIT_SMTP_HOST=
VOTEPIT_SMTP_PORT=587
VOTEPIT_SMTP_USER=
VOTEPIT_SMTP_PASS=
VOTEPIT_SMTP_ENCRYPTION=tls
VOTEPIT_SMTP_FROM_EMAIL=noreply@example.com
VOTEPIT_SMTP_FROM_NAME=Votepit

# Optional error monitoring (Sentry) — empty by default (no monitoring).
VOTEPIT_SENTRY_DSN=
VOTEPIT_SENTRY_DSN_FRONTEND=
