# Votepit — root .htaccess for hosts whose document root is the repository
# root (this folder) instead of public/.
#
# Every request is rewritten into public/ (the real webroot), so config/,
# src/, vendor/, migrations/, bin/, db/ and the rest are never served by URL.
# A request that matches no file in public/ falls through to the front
# controller there. Requests that already start with public/ are not
# rewritten again (no rewrite loop) and are answered by public/.htaccess.
#
# Without mod_rewrite nothing is routed, so the fallback below denies all.
# Note: an Apache with AllowOverride None ignores this file entirely;
# documentation/installation.md step 5 has the curl check for that case.
#
# If your host lets you point the document root at public/, do that instead —
# this file is then never read. Pinned by tests/Http/RootHtaccessTest.php.

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?!public/)(.*)$ public/$1 [L]
</IfModule>

<IfModule !mod_rewrite.c>
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</IfModule>
