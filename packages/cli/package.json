{
  "name": "@votepit/cli",
  "version": "0.1.0",
  "type": "module",
  "description": "Zero-dependency CLI for Votepit's Agent API (/api/v1/*) — read/create ideas without an MCP round-trip.",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "votepit": "./bin/votepit.mjs"
  },
  "files": [
    "bin",
    "src",
    "README.md"
  ],
  "scripts": {
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "vitest": "^4.1.9"
  }
}
